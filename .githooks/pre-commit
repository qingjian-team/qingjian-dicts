#!/usr/bin/env bash
# 构建产物（.qj / .qjz）只发 Release 附件，不进仓库；单个文件超过 50MB 也拦下（GitHub 的警告线）。
# 提交前跑一遍 tools/check.py。启用：git config core.hooksPath .githooks
set -euo pipefail
limit=$((50 * 1000 * 1000))
status=0
while IFS= read -r file; do
  [ -f "$file" ] || continue
  case "$file" in
    *.qj|*.qjz|*.qjm) echo "$file 是构建产物：发 Release 附件，不进仓库" >&2; status=1; continue ;;
  esac
  size=$(git cat-file -s ":$file")
  if [ "$size" -gt "$limit" ]; then
    echo "$file 有 $((size / 1000000)) MB：超过 50MB 的拆成几个文件（见 official/lexicon/zh/general）" >&2
    status=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR)
[ $status -eq 0 ] || exit $status
python3 tools/check.py
